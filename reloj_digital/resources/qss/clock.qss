QWidget {
    background-color: transparent;
}

QLabel {
    font-size: 20px;
    font-weight: 700;
    color: #1fbf75;
    background-color: #0b0f14;
    border-radius: 10px;
    padding: 14px;
}

/* ===============================
   TEXTO MODO ACTUAL
   =============================== */

QLabel#lbl_mode {
    font-size: 14px;
    font-weight: 500;
    color: #9aa4b2;
}

/* ===============================
   TEXTO "Minutos" TEMPORIZADOR
   =============================== */

QLabel#lbl_timer_minutes {
    font-size: 12px;
    color: #9aa4b2;
}