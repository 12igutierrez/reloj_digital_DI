<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DigitalClock</class>
 <widget class="QWidget" name="DigitalClock">
  <property name="minimumSize">
   <size>
    <width>220</width>
    <height>160</height>
   </size>
  </property>

  <layout class="QVBoxLayout" name="verticalLayout">

   <!-- TIEMPO -->
   <item>
    <widget class="QLabel" name="lbl_time">
     <property name="alignment">
      <set>Qt::AlignCenter</set>
     </property>
     <property name="text">
      <string>00:00</string>
     </property>
    </widget>
   </item>

   <!-- TEXTO MODO ACTUAL -->
   <item>
    <widget class="QLabel" name="lbl_mode">
     <property name="alignment">
      <set>Qt::AlignCenter</set>
     </property>
     <property name="text">
      <string>Cronómetro</string>
     </property>
    </widget>
   </item>

   <!-- BOTÓN CAMBIAR MODO -->
   <item>
    <widget class="QPushButton" name="btn_mode">
     <property name="text">
      <string>Cambiar modo</string>
     </property>
    </widget>
   </item>

   <!-- CONTROLES RELOJ -->
   <item>
    <widget class="QWidget" name="panel_clock">
     <layout class="QHBoxLayout">
      <item>
       <widget class="QPushButton" name="btn_format">
        <property name="text">
         <string>12 / 24 h</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btn_alarm">
        <property name="text">
         <string>Alarma</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- CONTROLES CRONÓMETRO -->
   <item>
    <widget class="QWidget" name="panel_stopwatch">
     <layout class="QHBoxLayout">
      <item>
       <widget class="QPushButton" name="btn_start">
        <property name="text">
         <string>Iniciar</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btn_pause">
        <property name="text">
         <string>Pausar</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btn_reset">
        <property name="text">
         <string>Reiniciar</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- CONTROLES TEMPORIZADOR -->
   <item>
    <widget class="QWidget" name="panel_timer">
     <layout class="QVBoxLayout">

      <!-- Selector de minutos -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QLabel" name="lbl_timer_minutes">
          <property name="text">
           <string>Minutos:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="spin_timer_minutes">
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>90</number>
          </property>
          <property name="value">
           <number>1</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>

      <!-- Botones temporizador -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QPushButton" name="btn_timer_start">
          <property name="text">
           <string>Iniciar</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_timer_pause">
          <property name="text">
           <string>Pausar</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_timer_reset">
          <property name="text">
           <string>Reiniciar</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>

     </layout>
    </widget>
   </item>

  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>